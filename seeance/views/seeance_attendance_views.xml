<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seeance_attendance_view_list" model="ir.ui.view">
        <field name="name">seeance.attendance.view.list</field>
        <field name="model">seeance.attendance</field>
        <field name="arch" type="xml">
            <list default_order="datetime desc" create="false">
                <field name="datetime"/>
                <field name="mechanism"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="work_location_id"/>
                <field name="check_point_id"/>
            </list>
        </field>
    </record>

    <record id="seeance_attendance_view_form" model="ir.ui.view">
        <field name="name">seeance.attendance.view.form</field>
        <field name="model">seeance.attendance</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="datetime"/>
                            <field name="mechanism"/>
                            <field name="user_id" required="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="work_location_id"/>
                            <field name="check_point_id"/>
                        </group>
                    </group>
                    <group string="Photo" invisible="not image">
                        <field name="image" widget="image" nolabel="1" options="{'size': [0, 300]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="seeance_attendance_view_search" model="ir.ui.view">
        <field name="name">seeance.attendance.view.search</field>
        <field name="model">seeance.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="check_point_id"/>
                <field name="work_location_id"/>
                <filter name="sign_in" string="Sign Ins" domain="[('mechanism', '=', 'sign_in')]"/>
                <filter name="sign_out" string="Sign Outs" domain="[('mechanism', '=', 'sign_out')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_check_point" string="Check Point" context="{'group_by': 'check_point_id'}"/>
                    <filter name="group_by_work_location" string="Work Location" context="{'group_by': 'work_location_id'}"/>
                    <filter name="group_by_mechanism" string="Mechanism" context="{'group_by': 'mechanism'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="seeance_attendance_action" model="ir.actions.act_window">
        <field name="name">Sign In/Out Records</field>
        <field name="res_model">seeance.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dev_ops_release_candidate_view_list" model="ir.ui.view">
        <field name="name">dev.ops.release.candidate.view.list</field>
        <field name="model">dev.ops.release.candidate</field>
        <field name="arch" type="xml">
            <list string="Release Candidates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="dev_ops_release_candidate_view_form" model="ir.ui.view">
        <field name="name">dev.ops.release.candidate.view.form</field>
        <field name="model">dev.ops.release.candidate</field>
        <field name="arch" type="xml">
            <form string="Release Candidate">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dev_ops_release_candidate_action" model="ir.actions.act_window">
        <field name="name">Release Candidates</field>
        <field name="res_model">dev.ops.release.candidate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dev_ops_sprint_view_list" model="ir.ui.view">
        <field name="name">dev.ops.sprint.view.list</field>
        <field name="model">dev.ops.sprint</field>
        <field name="arch" type="xml">
            <list string="Sprints">
                <field name="name"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'planning'"
                       decoration-warning="status in ('in_progress', 'testing')"
                       decoration-success="status == 'released'"
                       decoration-danger="status == 'cancelled'"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="release_date_general"/>
                <field name="release_candidate_id"/>
            </list>
        </field>
    </record>

    <record id="dev_ops_sprint_view_kanban" model="ir.ui.view">
        <field name="name">dev.ops.sprint.view.kanban</field>
        <field name="model">dev.ops.sprint</field>
        <field name="arch" type="xml">
            <kanban string="Sprints" default_group_by="status">
                <field name="name"/>
                <field name="status"/>
                <field name="icon"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <img t-att-src="kanban_image('dev.ops.sprint', 'icon', record.id.raw_value)"
                                 class="o_kanban_image rounded me-2" alt="Sprint icon" width="32" height="32"/>
                            <div>
                                <field name="name" class="fw-bold"/>
                                <div t-if="record.start_date.value or record.end_date.value">
                                    <field name="start_date"/> - <field name="end_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dev_ops_sprint_view_form" model="ir.ui.view">
        <field name="name">dev.ops.sprint.view.form</field>
        <field name="model">dev.ops.sprint</field>
        <field name="arch" type="xml">
            <form string="Sprint">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="planning,in_progress,testing,released"/>
                </header>
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sprint 42"/></h1>
                    </div>
                    <group>
                        <group string="Timeline">
                            <field name="start_date" widget="daterange"
                                   options="{'related_end_date': 'end_date'}"/>
                            <field name="end_date" widget="daterange"
                                   options="{'related_start_date': 'start_date'}"/>
                        </group>
                        <group string="Release">
                            <field name="release_candidate_id"/>
                            <field name="release_date_alpha"/>
                            <field name="release_date_beta"/>
                            <field name="release_date_general"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Release Notes" name="release_notes">
                            <field name="release_notes"/>
                        </page>
                        <page string="Trivia" name="trivia">
                            <field name="trivia"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dev_ops_sprint_action" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">dev.ops.sprint</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>

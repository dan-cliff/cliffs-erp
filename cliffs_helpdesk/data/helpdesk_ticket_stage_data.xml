<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="helpdesk_ticket_stage_new" model="helpdesk.ticket.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
    </record>
    <record id="helpdesk_ticket_stage_in_progress" model="helpdesk.ticket.stage">
        <field name="name">In Progress</field>
        <field name="sequence">20</field>
    </record>
    <record id="helpdesk_ticket_stage_on_hold" model="helpdesk.ticket.stage">
        <field name="name">On Hold</field>
        <field name="sequence">30</field>
    </record>
    <record id="helpdesk_ticket_stage_solved" model="helpdesk.ticket.stage">
        <field name="name">Solved</field>
        <field name="sequence">40</field>
        <field name="fold" eval="True"/>
        <field name="is_closed" eval="True"/>
    </record>
    <record id="helpdesk_ticket_stage_cancelled" model="helpdesk.ticket.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">50</field>
        <field name="fold" eval="True"/>
        <field name="is_closed" eval="True"/>
    </record>
</odoo>

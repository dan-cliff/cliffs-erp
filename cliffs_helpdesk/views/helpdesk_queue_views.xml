<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_queue_view_list" model="ir.ui.view">
        <field name="name">helpdesk.queue.view.list</field>
        <field name="model">helpdesk.queue</field>
        <field name="arch" type="xml">
            <list string="Queues">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="agent_ids" widget="many2many_tags"/>
                <field name="alias_name"/>
                <field name="ticket_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_queue_view_form" model="ir.ui.view">
        <field name="name">helpdesk.queue.view.form</field>
        <field name="model">helpdesk.queue</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Queue">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Queue Name"/>
                        <h1><field name="name" placeholder="e.g. Customer Support"/></h1>
                    </div>
                    <group>
                        <group string="Agents">
                            <field name="manager_id"/>
                            <field name="agent_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Email Alias">
                            <label for="alias_name" string="Email Alias"/>
                            <div class="o_row">
                                <field name="alias_name" placeholder="e.g. support"/>
                            </div>
                            <field name="alias_contact"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Internal notes about this queue..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_queue_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.queue.view.kanban</field>
        <field name="model">helpdesk.queue</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="name"/></strong>
                            <div>
                                <field name="agent_ids" widget="many2many_tags"/>
                            </div>
                            <div class="text-muted">
                                <field name="ticket_count"/> Tickets
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_queue_action" model="ir.actions.act_window">
        <field name="name">Queues</field>
        <field name="res_model">helpdesk.queue</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Queue
            </p><p>
                Queues group tickets and their Agents together. Give a queue an
                email alias so incoming support emails create tickets automatically.
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_priority_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.priority.view.list</field>
        <field name="model">helpdesk.ticket.priority</field>
        <field name="arch" type="xml">
            <list string="Priorities" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_priority_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.priority.view.form</field>
        <field name="model">helpdesk.ticket.priority</field>
        <field name="arch" type="xml">
            <form string="Priority">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_priority_action" model="ir.actions.act_window">
        <field name="name">Priorities</field>
        <field name="res_model">helpdesk.ticket.priority</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Priority
            </p><p>
                Higher sequence values are treated as more urgent.
            </p>
        </field>
    </record>
</odoo>

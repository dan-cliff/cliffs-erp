<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_source_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.source.view.list</field>
        <field name="model">helpdesk.ticket.source</field>
        <field name="arch" type="xml">
            <list string="Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_source_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.source.view.form</field>
        <field name="model">helpdesk.ticket.source</field>
        <field name="arch" type="xml">
            <form string="Source">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_source_action" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">helpdesk.ticket.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Source
            </p><p>
                Sources describe the channel a ticket came in through, e.g. Email or Phone.
            </p>
        </field>
    </record>
</odoo>

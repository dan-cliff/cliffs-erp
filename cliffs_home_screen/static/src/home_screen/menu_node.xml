<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cliffs_home_screen.MenuNode">
        <div t-attf-class="o_cliffs_menu_node o_cliffs_menu_node_level_{{props.level}} {{state.open ? 'o_cliffs_menu_node_open' : ''}}">
            <div class="o_cliffs_menu_node_row" t-on-click="onClick" role="button" tabindex="0">
                <div t-if="props.level === 0" class="o_cliffs_menu_node_icon_wrap">
                    <img t-if="!state.iconError" class="o_cliffs_menu_node_icon" t-att-src="iconUrl" alt=""
                         t-on-error="onIconError"/>
                    <i t-else="" class="fa fa-th-large o_cliffs_menu_node_icon_fallback"/>
                </div>
                <span class="o_cliffs_menu_node_name" t-esc="props.menu.name"/>
                <i t-if="hasChildren"
                   t-attf-class="fa {{state.open ? 'fa-chevron-down' : 'fa-chevron-right'}} o_cliffs_menu_node_caret"/>
            </div>
            <div class="o_cliffs_menu_node_children" t-if="state.open">
                <div t-if="state.loading" class="o_cliffs_menu_node_loading">
                    <i class="fa fa-circle-o-notch fa-spin"/>
                </div>
                <t t-else="">
                    <MenuNode t-foreach="state.children" t-as="child" t-key="child.id" menu="child" level="props.level + 1"/>
                </t>
            </div>
        </div>
    </t>
</templates>

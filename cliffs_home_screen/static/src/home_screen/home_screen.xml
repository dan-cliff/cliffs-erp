<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cliffs_home_screen.HomeScreen">
        <div class="o_cliffs_home_screen">
            <div class="o_cliffs_home_screen_header">
                <h2>Apps</h2>
            </div>
            <div t-if="state.apps.length" class="o_cliffs_home_screen_grid">
                <div t-foreach="state.apps" t-as="app" t-key="app.id"
                     class="o_cliffs_app_tile" t-on-click="() => this.onAppClick(app)"
                     role="button" tabindex="0">
                    <div class="o_cliffs_app_icon">
                        <img class="o_cliffs_app_icon_img" t-att-src="iconUrl(app)" alt=""
                             t-on-error="onIconError"/>
                        <i class="fa fa-th-large o_cliffs_app_icon_default"/>
                        <div t-if="state.loadingAppId === app.id" class="o_cliffs_app_icon_loading">
                            <i class="fa fa-circle-o-notch fa-spin"/>
                        </div>
                    </div>
                    <span class="o_cliffs_app_label" t-esc="app.name"/>
                </div>
            </div>
            <div t-else="" class="o_cliffs_home_screen_empty">
                No apps installed yet.
            </div>
        </div>
    </t>
</templates>

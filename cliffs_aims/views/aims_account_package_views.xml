<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aims_account_package_view_list" model="ir.ui.view">
        <field name="name">aims.account.package.view.list</field>
        <field name="model">aims.account.package</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="aims_account_package_view_form" model="ir.ui.view">
        <field name="name">aims.account.package.view.form</field>
        <field name="model">aims.account.package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aims_account_package" model="ir.actions.act_window">
        <field name="name">Account Packages</field>
        <field name="res_model">aims.account.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aims_cloud_provider_view_list" model="ir.ui.view">
        <field name="name">aims.cloud.provider.view.list</field>
        <field name="model">aims.cloud.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="aims_cloud_provider_view_form" model="ir.ui.view">
        <field name="name">aims.cloud.provider.view.form</field>
        <field name="model">aims.cloud.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aims_cloud_provider" model="ir.actions.act_window">
        <field name="name">Cloud Providers</field>
        <field name="res_model">aims.cloud.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

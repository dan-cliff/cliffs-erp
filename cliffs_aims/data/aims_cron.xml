<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_aims_sync_active_user_counts" model="ir.cron">
        <field name="name">AIMS: Sync Active User Counts</field>
        <field name="model_id" ref="model_aims_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_active_user_counts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>

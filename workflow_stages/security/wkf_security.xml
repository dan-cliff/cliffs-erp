<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Workflow Stages Security Groups                                   -->
    <!-- ================================================================ -->

    <record id="group_wkf_user" model="res.groups">
        <field name="name">Workflow Stages: User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Read-only access to workflow definitions, stages and transitions.</field>
    </record>

    <record id="group_wkf_manager" model="res.groups">
        <field name="name">Workflow Stages: Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('workflow_stages.group_wkf_user'))]"/>
        <field name="comment">Full create/edit/delete access to workflow definitions, stages and transitions — i.e. the workflow designer.</field>
    </record>

</odoo>

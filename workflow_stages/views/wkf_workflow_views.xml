<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- wkf.workflow — Form View                                          -->
    <!-- ================================================================ -->
    <record id="view_wkf_workflow_form" model="ir.ui.view">
        <field name="name">wkf.workflow.form</field>
        <field name="model">wkf.workflow</field>
        <field name="arch" type="xml">
            <form string="Workflow">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_canvas"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                title="Open the visual canvas editor">
                            <span class="o_stat_text">Visual<br/>Editor</span>
                        </button>
                        <button name="action_open_canvas"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-circle-o">
                            <field name="stage_count" widget="statinfo" string="Stages"/>
                        </button>
                        <button name="action_open_canvas"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-long-arrow-right">
                            <field name="transition_count" widget="statinfo" string="Transitions"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Workflow Name…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Target">
                            <field name="model_id" options="{'no_open': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stages" name="stages">
                            <p class="text-muted">
                                Use the <strong>Visual Editor</strong> button above to design
                                stages, transitions and their conditions on the canvas. This
                                list is a quick overview / bulk-editing fallback.
                            </p>
                            <field name="stage_ids" context="{'default_workflow_id': id}">
                                <list string="Stages" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_initial"/>
                                    <field name="is_final"/>
                                    <field name="allowed_user_count" string="Allowed Users"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentation" name="description">
                            <field name="description" placeholder="Describe what this workflow does…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- wkf.workflow — List View                                          -->
    <!-- ================================================================ -->
    <record id="view_wkf_workflow_list" model="ir.ui.view">
        <field name="name">wkf.workflow.list</field>
        <field name="model">wkf.workflow</field>
        <field name="arch" type="xml">
            <list string="Workflows">
                <field name="name"/>
                <field name="model_id" string="Model"/>
                <field name="stage_count" string="Stages"/>
                <field name="transition_count" string="Transitions"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- wkf.workflow — Search View                                        -->
    <!-- ================================================================ -->
    <record id="view_wkf_workflow_search" model="ir.ui.view">
        <field name="name">wkf.workflow.search</field>
        <field name="model">wkf.workflow</field>
        <field name="arch" type="xml">
            <search string="Workflows">
                <field name="name"/>
                <field name="model_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- wkf.workflow — Window Action                                      -->
    <!-- ================================================================ -->
    <record id="action_wkf_workflow" model="ir.actions.act_window">
        <field name="name">Workflows</field>
        <field name="res_model">wkf.workflow</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first workflow
            </p>
            <p>
                A workflow is a graph of stages and transitions that governs
                how records of a given model move from one stage to another.
            </p>
        </field>
    </record>

</odoo>

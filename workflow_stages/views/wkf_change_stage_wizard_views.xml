<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- wkf.change.stage.wizard — Form View                               -->
    <!-- ================================================================ -->
    <record id="view_wkf_change_stage_wizard_form" model="ir.ui.view">
        <field name="name">wkf.change.stage.wizard.form</field>
        <field name="model">wkf.change.stage.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Workflow Stage">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <!-- Loaded so its ids are available for the domain on
                     selected_transition_id below. -->
                <field name="transition_ids" invisible="1"/>

                <group>
                    <field name="record_display_name" string="Record" readonly="1"/>
                    <field name="current_stage_id" readonly="1"/>
                </group>

                <div class="alert alert-warning" role="alert"
                     invisible="transition_ids">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    No workflow transitions are currently available from this stage for you.
                </div>

                <group invisible="not transition_ids">
                    <field name="selected_transition_id"
                           widget="radio"
                           string="Move To"
                           options="{'no_create': True}"/>
                </group>

                <group>
                    <field name="note" placeholder="Optional note…"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Apply"
                            type="object"
                            class="btn-primary"
                            invisible="not transition_ids"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
